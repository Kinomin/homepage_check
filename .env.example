# Supabase（未設定の場合はプロトタイプ由来のデモデータで動作します）
# Project Settings → API の Project URL と anon public key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 走査・判定の書き込み用。サーバ側のバッチからのみ使用します。
# Project Settings → API の service_role key。ブラウザに渡らないよう NEXT_PUBLIC_ を付けないこと。
SUPABASE_SERVICE_ROLE_KEY=

# マイグレーション適用（npm run db:migrate）にのみ使います。アプリの実行には不要です。
# Project Settings → Database → Connection string (URI)
DATABASE_URL=

# 上の接続で使うCA証明書（パス、または PEM そのもの）。
# 既定でサーバ証明書を検証します。検証できない構成のときだけ設定してください。
# Project Settings → Database から取得できます。
DATABASE_CA_CERT=
# どうしても検証を通せないときの逃げ道。1 で検証を切ります（警告が出ます）。
# 経路上でサーバを差し替えられても気づけなくなるため、常用しないこと。
DATABASE_SSL_NO_VERIFY=

# 判定（Claude API）。未設定の場合、判定結果はすべて unknown になります。
ANTHROPIC_API_KEY=
# 既定は最も高性能な Claude Opus 5
ANTHROPIC_MODEL=claude-opus-5
# 判定の思考深度。31項目×6校の規模のため既定は low
JUDGE_EFFORT=low

# クロール時の User-Agent。連絡先URLを含めてください。
CRAWL_USER_AGENT=SchoolInsightBot/1.0 (+https://example.com/bot)

# 自動実行（/api/cron/scan）の共有シークレット。
# 未設定なら自動実行は無効になります。走査は外部サイトへのリクエストを伴うため、
# 誰でも叩ける状態にはしません。Vercel Cron はこの値を Bearer トークンとして送ります。
CRON_SECRET=
